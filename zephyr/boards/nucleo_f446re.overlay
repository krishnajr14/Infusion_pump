/*
 * nucleo_f446re.overlay
 * NUCLEO-F446RE device tree overlay
 *
 * Stepper wiring (TMC2209):
 * PB0 → STEP
 * PB1 → DIR
 * PB2 → EN  (active-low)
 *
 * Quadrature encoder:
 * TIM2 CH1 → PA0
 * TIM2 CH2 → PA1
 *
 * LPS22HB pressure sensor (I²C1):
 * PB6 → SCL
 * PB7 → SDA
 * I²C address: 0x5C (SA0=GND) or 0x5D (SA0=VDD)
 *
 * Dedicated Hardware Alarm Outputs:
 * PC7 → External Separate LED Alarm Light
 * PC6 → External Active Buzzer Alert
 */

&i2c1 {
    status = "okay";
    clock-frequency = <I2C_BITRATE_FAST>;
    pinctrl-0 = <&i2c1_scl_pb6 &i2c1_sda_pb7>;
    pinctrl-names = "default";
    lps22hb@5c {
        compatible = "st,lps22hb-press";
        reg = <0x5c>;
        label = "LPS22HB";
        status = "okay";
    };
};

/ {
    stepper_gpios {
        compatible = "gpio-leds";
        step_pin: step_pin {
            gpios = <&gpiob 0 GPIO_ACTIVE_HIGH>;
            label = "STEPPER_STEP";
        };
        dir_pin: dir_pin {
            gpios = <&gpiob 1 GPIO_ACTIVE_HIGH>;
            label = "STEPPER_DIR";
        };
        en_pin: en_pin {
            gpios = <&gpiob 2 GPIO_ACTIVE_LOW>;
            label = "STEPPER_EN";
        };
    };

    alarm_outputs {
        compatible = "gpio-leds";
        alarm_led: alarm_led {
            gpios = <&gpioc 7 GPIO_ACTIVE_HIGH>;
            label = "EXTERNAL_ALARM_LED";
        };
        alarm_buzzer: alarm_buzzer {
            gpios = <&gpioc 6 GPIO_ACTIVE_HIGH>;
            label = "EXTERNAL_ALARM_BUZZER";
        };
    };
};

&timers2 {
    status = "okay";
    st,prescaler = <0>;
    qdec {
        status = "okay";
        pinctrl-0 = <&tim2_ch1_pa0 &tim2_ch2_pa1>;
        pinctrl-names = "default";
        st,counts-per-revolution = <2400>; /* Added required encoder resolution parameter */
    };
};